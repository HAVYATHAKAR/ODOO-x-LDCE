# ────────────────────────────────────────────────────────────
# GlobeTrotter backend — environment configuration (EXAMPLE)
# Copy to `.env` and adjust. Never commit the real .env.
# ────────────────────────────────────────────────────────────

# ── Database ────────────────────────────────────────────────
# Production (PostgreSQL 16). Matches the repo docker-compose.yml.
DATABASE_URL=postgresql+psycopg2://globetrotter:globetrotter@localhost:5432/globetrotter
#
# Zero-setup local development / CI (SQLite, no server needed):
# DATABASE_URL=sqlite:///./globetrotter.db

# ── Auth / JWT ──────────────────────────────────────────────
# Generate a strong secret, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# ── Password reset ──────────────────────────────────────────
RESET_TOKEN_MINUTES=30

# ── CORS (comma-separated origins the SPA is served from) ───
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── App ─────────────────────────────────────────────────────
PROJECT_NAME=GlobeTrotter
API_V1_PREFIX=/api/v1
ENVIRONMENT=development
