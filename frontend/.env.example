# Frontend dev config. In dev, requests to /api are proxied to the backend
# (see vite.config.ts), so the default base path is same-origin "/api/v1".
# To point at a backend on another host, set an absolute URL, e.g.
# VITE_API_URL=http://localhost:8000/api/v1
VITE_API_URL=/api/v1

# Host:port the Vite dev proxy forwards /api to (backend uvicorn).
VITE_PROXY_TARGET=http://127.0.0.1:8000
